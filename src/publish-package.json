{
  "name": "@altbdoor/ffmpeg-wasm-custom",
  "version": "0.0.0",
  "description": "FFmpeg WebAssembly custom build with x264",
  "main": "./dist/umd/ffmpeg-core.js",
  "exports": {
    ".": {
      "import": "./dist/esm/ffmpeg-core.js",
      "require": "./dist/umd/ffmpeg-core.js"
    },
    "./wasm": {
      "import": "./dist/esm/ffmpeg-core.wasm",
      "require": "./dist/umd/ffmpeg-core.wasm"
    }
  },
  "files": ["dist"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/altbdoor/ffmpeg-wasm-custom.git"
  },
  "author": "altbdoor",
  "license": "GPL-2.0-or-later",
  "homepage": "https://github.com/altbdoor/ffmpeg-wasm-custom#readme",
  "publishConfig": {
    "access": "public"
  }
}
